# Рынок Предсказаний — environment variables
# Copy to .env and fill in your values

# Flask session secret key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
FLASK_SECRET_KEY=change-me-to-random-secret

# Supabase (or other) PostgreSQL connection
# Used instead of config.toml [postgres] section
# DATABASE_URL=postgresql://user:password@host:5432/dbname
PGPASSWORD=your-db-password

# OIDC credentials from vas3k.club
# Register your app at https://vas3k.club/apps/create/
OIDC_CLIENT_ID=your-client-id
OIDC_CLIENT_SECRET=your-client-secret

# Override base URL if using a dev instance of vas3k.club
# VAS3K_BASE_URL=https://vas3k.club

# Path to config.toml (default: config.toml)
# HANSON_CONFIG=config.toml
